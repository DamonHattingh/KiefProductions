@model IEnumerable<KiefProductions.Models.Gear>
@{ ViewData["Title"] = "Own Gear"; }

<div class="page-header">
    <div class="page-header-left">
        <h1>Own Gear</h1>
        <p>@Model.Count() item@(Model.Count() == 1 ? "" : "s")</p>
    </div>
    <div class="d-flex gap-2">
        <form method="get" class="search-bar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" name="search" class="form-control" placeholder="Search gear..." value="@ViewBag.Search" />
        </form>
        <select name="categoryId" class="form-select" style="width:180px;" onchange="this.form.submit()" form="filterForm">
            <option value="">All Categories</option>
            @foreach (var cat in ViewBag.Categories)
            {
                <option value="@cat.Id" selected="@(ViewBag.CategoryId == cat.Id)">@cat.Name</option>
            }
        </select>
        <form id="filterForm" method="get"></form>
        <a href="/Gear/Create" class="btn btn-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Add Gear
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
            <h3>No gear added yet</h3>
            <p>Add your owned equipment to start building quotes</p>
            <a href="/Gear/Create" class="btn btn-primary">Add Gear</a>
        </div>
    </div>
}
else
{
    <div class="table-wrapper">
        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Type</th>
                    <th>Description</th>
                    <th>Market Price</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var gear in Model)
                {
                    <tr>
                        <td style="font-weight:500;">@gear.Name</td>
                        <td class="muted">@gear.ProductType.Category.Name</td>
                        <td class="muted">@gear.ProductType.Name</td>
                        <td class="muted" style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@(gear.Description ?? "—")</td>
                        <td style="font-family:'Outfit',sans-serif;font-weight:600;">R @gear.MarketPrice.ToString("N2")</td>
                        <td>
                            <div class="table-actions">
                                <a href="/Gear/Edit/@gear.Id" class="btn btn-ghost btn-sm" data-tooltip="Edit">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                </a>
                                <form asp-action="Delete" asp-route-id="@gear.Id" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm" data-confirm="Delete this gear item?" data-tooltip="Delete">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/></svg>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
