@model KiefProductions.Controllers.VendorDocumentUploadViewModel
@{
    ViewData["Title"] = "Upload Vendor Document";
    var events = ViewBag.Events as List<KiefProductions.Models.Event> ?? new();
}

<div class="breadcrumb">
    <a href="/VendorDocuments">Vendor Documents</a>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6" /></svg>
    <span class="current">Upload</span>
</div>

<div style="max-width:640px;">
    @if (!Model.IsUploaded)
    {
        <div class="card">
            <div class="card-header"><h2>Upload Invoice or Quote</h2></div>
            <form asp-action="Upload" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <div class="form-group">
                        <label class="form-label">File <span class="required">*</span></label>
                        <input type="file" name="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png" required />
                        <span class="form-hint">PDF, JPG or PNG. We'll try to auto-fill the vendor name, document number, date and amount from PDFs with real text — otherwise fill them in yourself on the next step.</span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Event</label>
                        <select name="eventId" class="form-select">
                            <option value="">— Not linked to an event —</option>
                            @foreach (var ev in events)
                            {
                                <option value="@ev.Id" selected="@(Model.EventId == ev.Id)">@ev.EventName</option>
                            }
                        </select>
                        <span class="form-hint">Optional — link this to a shoot/event if relevant</span>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="17 8 12 3 7 8" /><line x1="12" y1="3" x2="12" y2="15" /></svg>
                        Upload &amp; Continue
                    </button>
                    <a href="/VendorDocuments" class="btn btn-ghost">Cancel</a>
                </div>
            </form>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-header"><h2>Confirm Details</h2></div>
            <form asp-action="Save" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="FileName" />
                <input type="hidden" asp-for="OriginalFileName" />
                <input type="hidden" asp-for="ContentType" />
                <input type="hidden" asp-for="IsUploaded" />
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    @if (Model.TextExtracted)
                    {
                        <div class="alert alert-info">We pulled these fields automatically from the file — check them over before saving.</div>
                    }
                    else
                    {
                        <div class="alert alert-warning">We couldn't read text from this file automatically (likely a scan/photo) — please fill in the details below.</div>
                    }

                    <div class="form-group">
                        <label class="form-label">Uploaded File</label>
                        <div><a href="/@("uploads/vendor-docs/" + Model.FileName)" target="_blank" rel="noopener">@Model.OriginalFileName</a></div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Vendor / Company Name <span class="required">*</span></label>
                            <input asp-for="VendorName" class="form-control" placeholder="e.g. Sunset Studios" />
                            <span asp-validation-for="VendorName" class="form-error"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Document Type</label>
                            <select asp-for="DocumentType" class="form-select">
                                @foreach (var t in Enum.GetValues<KiefProductions.Models.VendorDocumentType>())
                                {
                                    <option value="@t" selected="@(Model.DocumentType == t)">@t</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Document Number</label>
                            <input asp-for="DocumentNumber" class="form-control" placeholder="e.g. INV-2026-045" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Document Date</label>
                            <input asp-for="DocumentDate" type="date" class="form-control" />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Amount</label>
                            <input asp-for="Amount" type="number" step="0.01" class="form-control" placeholder="0.00" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Event</label>
                            <select asp-for="EventId" class="form-select">
                                <option value="">— Not linked to an event —</option>
                                @foreach (var ev in events)
                                {
                                    <option value="@ev.Id" selected="@(Model.EventId == ev.Id)">@ev.EventName</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Notes</label>
                        <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Optional notes"></textarea>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" /><polyline points="17 21 17 13 7 13 7 21" /><polyline points="7 3 7 8 15 8" /></svg>
                        Save Document
                    </button>
                    <a href="/VendorDocuments" class="btn btn-ghost">Cancel</a>
                </div>
            </form>
        </div>
    }
</div>
