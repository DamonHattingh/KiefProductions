@model IEnumerable<KiefProductions.Models.Client>

@if (!Model.Any())
{
    <div class="card">
        <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /></svg>
            <h3>No clients yet</h3>
            <p>Add your first client to get started</p>
            <a href="/Clients/Create" class="btn btn-primary">Add Client</a>
        </div>
    </div>
}
else
{
    <div class="table-wrapper">
        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Business</th>
                    <th>Status</th>
                    <th>Joined</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var client in Model)
                {
                    <tr data-client-id="@client.Id" data-client-name="@client.FullName" data-has-quotes="@(client.Quotes.Any() ? "true" : "false")" data-has-invoices="@(client.Invoices.Any() ? "true" : "false")">
                        <td>
                            <a href="/Clients/Details/@client.Id" style="color:var(--text-primary);text-decoration:none;font-weight:500;">
                                @client.FullName
                            </a>
                        </td>
                        <td class="muted">@client.Email</td>
                        <td class="muted">
                            @(string.IsNullOrEmpty(client.Phone)
                                                ? "—"
                                                : $"{client.Phone.Substring(0, 3)} {client.Phone.Substring(3, 3)} {client.Phone.Substring(6)}")
                        </td>
                        <td class="muted">@(client.BusinessName ?? "—")</td>
                        <td>
                            <span class="badge @(client.IsActive ? "badge-active" : "badge-inactive")">
                                @(client.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td class="muted">@client.CreatedDate.ToString("dd MMM yyyy")</td>
                        <td>
                            <div class="table-actions">
                                <a href="/Clients/Details/@client.Id" class="btn btn-ghost btn-sm" data-tooltip="View">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                                </a>
                                <a href="/Clients/Edit/@client.Id" class="btn btn-ghost btn-sm" data-tooltip="Edit">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
                                </a>
                                <button type="button" class="btn btn-danger btn-sm deactivate-client" data-client-id="@client.Id" data-client-name="@client.FullName" data-has-quotes="@(client.Quotes.Any() ? "true" : "false")" data-has-invoices="@(client.Invoices.Any() ? "true" : "false")" data-is-active="@(client.IsActive ? "true" : "false")" data-tooltip="Deactivate">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14H6L5 6" /><path d="M10 11v6" /><path d="M14 11v6" /></svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (ViewBag.TotalPages > 1)
    {
        <div class="pages-div">
            @{
                int currentPage = ViewBag.CurrentPage;
                int totalPages = ViewBag.TotalPages;
            }

            <a class="btn btn-ghost btn-sm page-btn @(currentPage == 1 ? "disabled" : "")"
               href="#" data-page="@(currentPage - 1)">
                Previous
            </a>

            @for (int i = 1; i <= totalPages; i++)
            {
                <a class="btn btn-sm page-btn @(i == currentPage ? "btn-primary" : "btn-ghost")"
                   href="#" data-page="@i">
                    @i
                </a>
            }

            <a class="btn btn-ghost btn-sm page-btn @(currentPage == totalPages ? "disabled" : "")"
               href="#" data-page="@(currentPage + 1)">
                Next
            </a>
        </div>
    }

}
