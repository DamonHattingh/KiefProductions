@model IEnumerable<KiefProductions.Models.Client>
@{
    ViewData["Title"] = "Clients";
}

<div class="page-header">
    <div class="page-header-left">
        <h1>Clients</h1>
        <p>@Model.Count() client@(Model.Count() == 1 ? "" : "s") total</p>
    </div>
    <div class="d-flex gap-2">
        <form method="get" class="search-bar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
            <input type="text" name="search" id="clientSearchBox" class="form-control" placeholder="Search clients..." value="@ViewBag.Search" />
        </form> 
        <a href="/Clients/Create" class="btn btn-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
            New Client
        </a>
    </div>
</div>

<div id="clientResults">
    @await Html.PartialAsync("_ClientsTable", Model)
</div>


@section Scripts {

     <script>
        makeDynamicTable({
            containerId: 'clientResults',
            searchInputId: 'clientSearchBox',
            url: '/Clients/Index'
        });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const deactivateButtons = document.querySelectorAll('.deactivate-client');

            deactivateButtons.forEach(button => {
                button.addEventListener('click', async function (e) {
                    e.preventDefault();

                    const clientId = this.getAttribute('data-client-id');
                    const clientName = this.getAttribute('data-client-name');
                    const hasQuotes = this.getAttribute('data-has-quotes') === 'true';
                    const hasInvoices = this.getAttribute('data-has-invoices') === 'true';
                    const isActive = this.getAttribute('data-is-active') === 'true';

                    // If client is already inactive
                    if (!isActive) {
                        await Swal.fire({
                            title: 'Client Already Inactive',
                            html: `<strong>${clientName}</strong> is already deactivated.`,
                            icon: 'info',
                            confirmButtonColor: '#3b82f6',
                            confirmButtonText: 'OK',
                            background: '#16181c',
                            color: '#e0e0e0'
                        });
                        return;
                    }

                    // Check if client has quotes or invoices
                    if (hasQuotes || hasInvoices) {
                        let reasons = [];
                        if (hasQuotes) reasons.push(`• Has ${this.closest('tr').querySelectorAll('[data-has-quotes="true"]').length} active quote(s)`);
                        if (hasInvoices) reasons.push(`• Has ${this.closest('tr').querySelectorAll('[data-has-invoices="true"]').length} invoice(s)`);

                        await Swal.fire({
                            title: 'Cannot Deactivate Client',
                            html: `Client <strong>${clientName}</strong> has associated records:<br><br>${reasons.join('<br>')}<br><br>Please resolve these records before deactivating.`,
                            icon: 'warning',
                            confirmButtonColor: '#d33',
                            confirmButtonText: 'OK',
                            background: '#16181c',
                            color: '#e0e0e0',
                            iconColor: '#ff6b6b'
                        });
                        return;
                    }

                    // Show confirmation dialog
                    const result = await Swal.fire({
                        title: 'Deactivate Client?',
                        html: `Are you sure you want to deactivate <strong>${clientName}</strong>?<br><br>They will not be able to create new quotes or invoices.`,
                        icon: 'warning',
                        background: '#16181c',
                        color: '#e0e0e0',
                        iconColor: '#ff6b6b',
                        confirmButtonColor: '#d33',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: 'Yes, deactivate',
                        cancelButtonText: 'Cancel',
                        showCancelButton: true
                    });

                    if (result.isConfirmed) {
                        await Swal.fire({
                            title: 'Deactivated!',
                            text: `${clientName} has been deactivated.`,
                            icon: 'success',
                            confirmButtonColor: '#4caf50',
                            background: '#16181c',
                            color: '#e0e0e0',
                            iconColor: '#4caf50',
                            timer: 1500,
                            showConfirmButton: true
                        });

                        const form = document.createElement('form');
                        form.method = 'POST';
                        form.action = `/Clients/Delete/${clientId}`;
                        form.style.display = 'none';

                        const token = document.createElement('input');
                        token.type = 'hidden';
                        token.name = '__RequestVerificationToken';
                        token.value = antiForgeryToken;

                        form.appendChild(token);
                        document.body.appendChild(form);
                        form.submit();
                    }
                });
            });
        });
    </script>

}