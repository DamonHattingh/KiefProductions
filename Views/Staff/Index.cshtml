@model IEnumerable<KiefProductions.Models.StaffMember>
@{ ViewData["Title"] = "Staff"; }

<div class="page-header">
    <div class="page-header-left">
        <h1>Staff</h1>
        <p>@Model.Count(s => s.IsActive) active member@(Model.Count(s => s.IsActive) == 1 ? "" : "s")</p>
    </div>
    <a href="/Staff/Create" class="btn btn-primary">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Add Staff Member
    </a>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><polyline points="17 11 19 13 23 9"/></svg>
            <h3>No staff members yet</h3>
            <p>Add team members to assign them to events</p>
            <a href="/Staff/Create" class="btn btn-primary">Add Staff Member</a>
        </div>
    </div>
}
else
{
    <div class="table-wrapper">
        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Role</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Flat Rate</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td style="font-weight:500;">@s.FullName</td>
                        <td class="muted">@(s.Role ?? "—")</td>
                        <td class="muted">@(s.Email ?? "—")</td>
                        <td class="muted">@(s.Phone ?? "—")</td>
                        <td style="font-family:'Outfit',sans-serif;font-weight:600;color:var(--orange);">R @s.FlatRate.ToString("N2")</td>
                        <td><span class="badge @(s.IsActive ? "badge-active" : "badge-inactive")">@(s.IsActive ? "Active" : "Inactive")</span></td>
                        <td>
                            <div class="table-actions">
                                <a href="/Staff/Edit/@s.Id" class="btn btn-ghost btn-sm" data-tooltip="Edit">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                </a>
                                <form asp-action="Delete" asp-route-id="@s.Id" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm" data-confirm="Deactivate this staff member?" data-tooltip="Deactivate">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/></svg>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
