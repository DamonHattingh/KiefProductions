@model KiefProductions.Models.StaffMember
@{ ViewData["Title"] = "Add Staff Member"; }

<div class="breadcrumb">
    <a href="/Staff">Staff</a>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
    <span class="current">Add Staff Member</span>
</div>

<div style="max-width:600px;">
    <div class="card">
        <div class="card-header"><h2>Add Staff Member</h2></div>
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="card-body">
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Full Name <span class="required">*</span></label>
                        <input asp-for="FullName" class="form-control" placeholder="e.g. Thabo Nkosi" />
                        <span asp-validation-for="FullName" class="form-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Role / Position</label>
                        <input asp-for="Role" class="form-control" placeholder="e.g. Sound Engineer, Photographer" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" placeholder="thabo@example.com" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Phone</label>
                        <input asp-for="Phone" class="form-control" placeholder="082 000 0000" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Flat Rate per Event (R)</label>
                    <div class="input-group">
                        <span class="input-group-text">R</span>
                        <input asp-for="FlatRate" type="number" class="form-control currency-input" step="0.01" min="0" placeholder="0.00" />
                    </div>
                    <span class="form-hint">This amount is used in profit calculations when staff is assigned to an event</span>
                </div>
            </div>
            <div class="card-footer">
                <button type="submit" class="btn btn-primary">Save Staff Member</button>
                <a href="/Staff" class="btn btn-ghost">Cancel</a>
            </div>
        </form>
    </div>
</div>
