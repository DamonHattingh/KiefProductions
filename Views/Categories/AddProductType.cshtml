@model KiefProductions.Models.ProductType
@{ ViewData["Title"] = "Add Product Type"; }
<div class="breadcrumb">
    <a href="/Categories">Categories</a>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
    <span class="current">Add Type to @ViewBag.CategoryName</span>
</div>
<div style="max-width:480px;">
    <div class="card">
        <div class="card-header"><h2>Add Product Type</h2></div>
        <form asp-action="AddProductType" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="CategoryId" type="hidden" />
            <div class="card-body">
                <div class="form-group">
                    <label class="form-label">Type Name <span class="required">*</span></label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Mixing Desks, Moving Heads, Cameras" />
                    <span asp-validation-for="Name" class="form-error"></span>
                </div>
            </div>
            <div class="card-footer">
                <button type="submit" class="btn btn-primary">Add Type</button>
                <a href="/Categories" class="btn btn-ghost">Cancel</a>
            </div>
        </form>
    </div>
</div>
