@model KiefProductions.Models.ProductType
@{
    ViewData["Title"] = "Edit Product Type";
}

<div class="breadcrumb">
    <a href="/Categories">Categories</a>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6" /></svg>
    <span class="current">Edit Type</span>
</div>

<div style="max-width:480px;">
    <div class="card">
        <div class="card-header">
            <h2>Edit Product Type</h2>
            <span style="font-size:12px;color:var(--text-muted);">@ViewBag.CategoryName</span>
        </div>
        <form asp-action="EditProductType" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <input asp-for="CategoryId" type="hidden" />
            <div class="card-body">
                <div class="form-group">
                    <label class="form-label">Type Name <span class="required">*</span></label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Mixing Desks, Moving Heads" />
                    <span asp-validation-for="Name" class="form-error"></span>
                </div>
            </div>
            <div class="card-footer">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a href="/Categories" class="btn btn-ghost">Cancel</a>
            </div>
        </form>
    </div>
</div>
