@model IEnumerable<KiefProductions.Models.Invoice>
@{
    ViewData["Title"] = "Invoices";
}

<div class="page-header">
    <div class="page-header-left">
        <h1>Invoices</h1>
        <p id="totalCountLabel">@ViewBag.TotalCount invoice@(ViewBag.TotalCount == 1 ? "" : "s")</p>
    </div>
    <form method="get" class="search-bar" id="searchForm" onsubmit="return false;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
        <input type="text" name="search" id="invoiceSearchBox" class="form-control" placeholder="Search invoices..." value="@ViewBag.Search" />
    </form>
</div>

<div id="invoiceResults">
    @await Html.PartialAsync("_InvoiceTable", Model)
</div>

@section Scripts {
    <script>
        makeDynamicTable({
            containerId: 'invoiceResults',
            searchInputId: 'invoiceSearchBox',
            url: '/Invoices/Index'
        });
    </script>
}