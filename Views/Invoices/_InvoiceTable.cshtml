@model IEnumerable<KiefProductions.Models.Invoice>

@if (!Model.Any())
{
    <div class="card">
        <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="4" width="22" height="16" rx="2" /><line x1="1" y1="10" x2="23" y2="10" /></svg>
            <h3>No invoices yet</h3>
            <p>Invoices are created by converting an approved quote</p>
        </div>
    </div>
}
else
{
    <div class="table-wrapper">
        <table class="table">
            <thead>
                <tr>
                    <th>Invoice #</th>
                    <th>Client</th>
                    <th>Status</th>
                    <th>Total</th>
                    <th>Paid</th>
                    <th>Balance Due</th>
                    <th>Due Date</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var inv in Model)
                {
                    <tr>
                        <td>
                            <a href="/Invoices/Details/@inv.Id" style="color:var(--text-primary);text-decoration:none;font-weight:500;">@inv.InvoiceNumber</a>
                        </td>
                        <td class="muted">@inv.Client.FullName</td>
                        <td><span class="badge badge-@inv.Status.ToString().ToLower()">@inv.Status</span></td>
                        <td style="font-family:'Outfit',sans-serif;font-weight:600;">@inv.Total.ToString("C")</td>
                        <td style="color:var(--green);font-weight:600;">@inv.AmountPaid.ToString("C")</td>
                        <td style="color:@(inv.BalanceDue > 0 ? "var(--red)" : "var(--green)");font-family:'Outfit',sans-serif;font-weight:600;">
                            @inv.BalanceDue.ToString("C")
                        </td>
                        <td class="muted" style="color:@(inv.DueDate < DateTime.Now && inv.Status != KiefProductions.Models.InvoiceStatus.Paid ? "var(--red)" : "")">
                            @inv.DueDate.ToString("dd MMM yyyy")
                        </td>
                        <td>
                            <div class="table-actions">
                                <a href="/Invoices/Details/@inv.Id" class="btn btn-ghost btn-sm" data-tooltip="View">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                                </a>
                                <form asp-action="Delete" asp-route-id="@inv.Id" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm" data-confirm="Delete this invoice?" data-tooltip="Delete">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14H6L5 6" /></svg>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (ViewBag.TotalPages > 1)
    {
        <div class="pages-div">
            @{
                int currentPage = ViewBag.CurrentPage;
                int totalPages = ViewBag.TotalPages;
            }

            <a class="btn btn-ghost btn-sm page-btn @(currentPage == 1 ? "disabled" : "")"
               href="#" data-page="@(currentPage - 1)">
                Previous
            </a>

            @for (int i = 1; i <= totalPages; i++)
            {
                <a class="btn btn-sm page-btn @(i == currentPage ? "btn-primary" : "btn-ghost")"
                   href="#" data-page="@i">
                    @i
                </a>
            }

            <a class="btn btn-ghost btn-sm page-btn @(currentPage == totalPages ? "disabled" : "")"
               href="#" data-page="@(currentPage + 1)">
                Next
            </a>
        </div>
    }

}