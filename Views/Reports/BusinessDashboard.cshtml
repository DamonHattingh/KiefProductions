@model KiefProductions.ViewModels.BusinessDashboardViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Business Dashboard";
    var chartLabels = JsonSerializer.Serialize(Model.MonthlyRevenue.Select(m => m.Month));
    var chartRevenue = JsonSerializer.Serialize(Model.MonthlyRevenue.Select(m => m.Revenue));
    var chartProfit = JsonSerializer.Serialize(Model.MonthlyRevenue.Select(m => m.Profit));
    var donutData = JsonSerializer.Serialize(new[] {
        Model.InvoicesPaid, Model.InvoicesSent, Model.InvoicesPartiallyPaid,
        Model.InvoicesOverdue, Model.InvoicesDraft
    });
}

<div class="page-header" style="flex-wrap:wrap;gap:12px;">
    <div>
        <div class="breadcrumb">
            <a href="/Reports">Reports</a>
            <span>/</span>
            <span>Business Dashboard</span>
        </div>
        <h1 class="page-title">Business Dashboard</h1>
    </div>
    <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
        <form method="get" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
            <div class="form-group" style="margin:0;">
                <input type="date" name="startDate" class="form-control" style="width:150px;"
                       value="@Model.StartDate.ToString("yyyy-MM-dd")" />
            </div>
            <span style="color:var(--text-muted);font-size:0.85rem;">to</span>
            <div class="form-group" style="margin:0;">
                <input type="date" name="endDate" class="form-control" style="width:150px;"
                       value="@Model.EndDate.ToString("yyyy-MM-dd")" />
            </div>
            <button type="submit" class="btn btn-primary">Apply</button>
        </form>
        <a href="/Reports/BusinessDashboard?startDate=@Model.StartDate.ToString("yyyy-MM-dd")&endDate=@Model.EndDate.ToString("yyyy-MM-dd")&exportPdf=true"
           class="btn btn-secondary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Export PDF
        </a>
    </div>
</div>

<p style="color:var(--text-muted);font-size:0.85rem;margin-bottom:24px;">
    Showing data from <strong>@Model.StartDate.ToString("d MMM yyyy")</strong> to <strong>@Model.EndDate.ToString("d MMM yyyy")</strong>
</p>

<!-- Finance KPIs -->
<div class="stats-grid" style="grid-template-columns:repeat(auto-fill,minmax(180px,1fr));margin-bottom:24px;">
    <div class="stat-card">
        <div class="stat-label">Total Revenue</div>
        <div class="stat-value">R @Model.TotalRevenue.ToString("N2")</div>
        <div class="stat-sub">from paid invoices</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Net Profit</div>
        <div class="stat-value" style="color:@(Model.NetProfit >= 0 ? "#22c55e" : "#ef4444");">
            R @Model.NetProfit.ToString("N2")
        </div>
        <div class="stat-sub">@Model.ProfitMarginPercent% margin</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Outstanding</div>
        <div class="stat-value" style="color:#f59e0b;">R @Model.TotalOutstanding.ToString("N2")</div>
        <div class="stat-sub">yet to be collected</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Overdue</div>
        <div class="stat-value" style="color:#ef4444;">R @Model.TotalOverdue.ToString("N2")</div>
        <div class="stat-sub">past due date</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Avg Invoice</div>
        <div class="stat-value">R @Model.AverageInvoiceValue.ToString("N2")</div>
        <div class="stat-sub">on paid invoices</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Largest Invoice</div>
        <div class="stat-value">R @Model.LargestInvoiceValue.ToString("N2")</div>
        <div class="stat-sub">in period</div>
    </div>
</div>

<!-- Charts row -->
<div style="display:grid;grid-template-columns:1fr 320px;gap:20px;margin-bottom:24px;" class="charts-row">

    <!-- Revenue & Profit chart -->
    <div class="card" style="padding:24px;">
        <h3 class="section-title" style="margin-bottom:16px;">Monthly Revenue &amp; Profit</h3>
        @if (!Model.MonthlyRevenue.Any())
        {
            <div class="empty-state" style="padding:40px 0;">
                <p>No paid invoices in this period.</p>
            </div>
        }
        else
        {
            <canvas id="revenueChart" height="220"></canvas>
        }
    </div>

    <!-- Invoice status donut -->
    <div class="card" style="padding:24px;">
        <h3 class="section-title" style="margin-bottom:16px;">Invoice Status</h3>
        @if (Model.TotalInvoices == 0)
        {
            <div class="empty-state" style="padding:40px 0;">
                <p>No invoices in this period.</p>
            </div>
        }
        else
        {
            <canvas id="statusChart" height="200"></canvas>
            <div style="margin-top:14px;display:flex;flex-direction:column;gap:6px;">
                <div class="donut-legend-item"><span style="background:#22c55e;"></span> Paid (@Model.InvoicesPaid)</div>
                <div class="donut-legend-item"><span style="background:#3b82f6;"></span> Sent (@Model.InvoicesSent)</div>
                <div class="donut-legend-item"><span style="background:#f59e0b;"></span> Partial (@Model.InvoicesPartiallyPaid)</div>
                <div class="donut-legend-item"><span style="background:#ef4444;"></span> Overdue (@Model.InvoicesOverdue)</div>
                <div class="donut-legend-item"><span style="background:#6b7280;"></span> Draft (@Model.InvoicesDraft)</div>
            </div>
        }
    </div>
</div>

<!-- Quotes & Business Health row -->
<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:24px;" class="two-col-grid">

    <!-- Quote stats -->
    <div class="card" style="padding:24px;">
        <h3 class="section-title" style="margin-bottom:16px;">Quote Performance</h3>
        <div class="kpi-list">
            <div class="kpi-row">
                <span>Total Quoted Value</span>
                <strong>R @Model.TotalQuotedValue.ToString("N2")</strong>
            </div>
            <div class="kpi-row">
                <span>Conversion Rate</span>
                <strong>@Model.QuoteConversionRate%</strong>
            </div>
            <div class="kpi-row">
                <span>Average Quote Value</span>
                <strong>R @Model.AverageQuoteValue.ToString("N2")</strong>
            </div>
            <div class="kpi-row">
                <span>Total Quotes</span>
                <strong>@Model.TotalQuotes</strong>
            </div>
        </div>
        <div style="margin-top:16px;">
            <div style="font-size:0.78rem;color:var(--text-muted);margin-bottom:8px;">Status breakdown</div>
            <div style="display:flex;gap:6px;flex-wrap:wrap;">
                <span class="badge badge-secondary">Draft @Model.QuotesDraft</span>
                <span class="badge badge-warning">Pending @Model.QuotesPending</span>
                <span class="badge badge-success">Approved @Model.QuotesApproved</span>
                <span class="badge badge-danger">Rejected @Model.QuotesRejected</span>
                <span class="badge badge-info">Converted @Model.QuotesConverted</span>
            </div>
        </div>
    </div>

    <!-- Business health -->
    <div class="card" style="padding:24px;">
        <h3 class="section-title" style="margin-bottom:16px;">Business Health</h3>
        <div class="kpi-list">
            <div class="kpi-row">
                <span>Events in Period</span>
                <strong>@Model.TotalEvents</strong>
            </div>
            <div class="kpi-row">
                <span>Completed Events</span>
                <strong>@Model.CompletedEvents</strong>
            </div>
            <div class="kpi-row">
                <span>Clients Served</span>
                <strong>@Model.TotalClientsServed</strong>
            </div>
            <div class="kpi-row">
                <span>Repeat Clients</span>
                <strong>@Model.RepeatClients (@Model.RepeatClientRate%)</strong>
            </div>
            @if (!string.IsNullOrEmpty(Model.BestMonth))
            {
                <div class="kpi-row">
                    <span>Best Month</span>
                    <strong>@Model.BestMonth (R @Model.BestMonthRevenue.ToString("N2"))</strong>
                </div>
            }
        </div>
    </div>
</div>

<!-- Overdue Aging -->
@if (Model.TotalOverdue > 0)
{
    <div class="card" style="padding:24px;margin-bottom:24px;">
        <h3 class="section-title" style="margin-bottom:16px;">Overdue Aging</h3>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;">
            <div style="background:var(--bg-surface);border-radius:var(--radius-md);padding:16px;border-left:3px solid #f59e0b;">
                <div style="font-size:0.78rem;color:var(--text-muted);margin-bottom:4px;">0 – 30 days</div>
                <div style="font-size:1.25rem;font-weight:600;color:#f59e0b;">R @Model.Overdue30Days.ToString("N2")</div>
            </div>
            <div style="background:var(--bg-surface);border-radius:var(--radius-md);padding:16px;border-left:3px solid #f97316;">
                <div style="font-size:0.78rem;color:var(--text-muted);margin-bottom:4px;">31 – 60 days</div>
                <div style="font-size:1.25rem;font-weight:600;color:#f97316;">R @Model.Overdue60Days.ToString("N2")</div>
            </div>
            <div style="background:var(--bg-surface);border-radius:var(--radius-md);padding:16px;border-left:3px solid #ef4444;">
                <div style="font-size:0.78rem;color:var(--text-muted);margin-bottom:4px;">60+ days</div>
                <div style="font-size:1.25rem;font-weight:600;color:#ef4444;">R @Model.Overdue90PlusDays.ToString("N2")</div>
            </div>
        </div>
    </div>
}

@section Styles {
<style>
.kpi-list { display: flex; flex-direction: column; gap: 10px; }
.kpi-row { display: flex; justify-content: space-between; align-items: center; font-size: 0.875rem; color: var(--text-secondary); border-bottom: 1px solid var(--border); padding-bottom: 10px; }
.kpi-row:last-child { border-bottom: none; padding-bottom: 0; }
.kpi-row strong { color: var(--text-primary); }
.donut-legend-item { display: flex; align-items: center; gap: 8px; font-size: 0.8rem; color: var(--text-muted); }
.donut-legend-item span { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
@@media (max-width: 900px) { .charts-row, .two-col-grid { grid-template-columns: 1fr !important; } }
</style>
}

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
(function () {
    Chart.defaults.color = '#9ca3af';
    Chart.defaults.borderColor = 'rgba(255,255,255,0.06)';

    var labels = @Html.Raw(chartLabels);
    var revenue = @Html.Raw(chartRevenue);
    var profit = @Html.Raw(chartProfit);

    if (labels.length > 0) {
        new Chart(document.getElementById('revenueChart'), {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    { label: 'Revenue', data: revenue, backgroundColor: 'rgba(59,130,246,0.7)', borderRadius: 4 },
                    { label: 'Profit', data: profit, backgroundColor: 'rgba(34,197,94,0.7)', borderRadius: 4 }
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { position: 'top' } },
                scales: {
                    y: { ticks: { callback: v => 'R ' + v.toLocaleString() } }
                }
            }
        });
    }

    var donutData = @Html.Raw(donutData);
    if (@Model.TotalInvoices > 0) {
        new Chart(document.getElementById('statusChart'), {
            type: 'doughnut',
            data: {
                labels: ['Paid', 'Sent', 'Partial', 'Overdue', 'Draft'],
                datasets: [{
                    data: donutData,
                    backgroundColor: ['#22c55e','#3b82f6','#f59e0b','#ef4444','#6b7280'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                cutout: '68%'
            }
        });
    }
})();
</script>
}
