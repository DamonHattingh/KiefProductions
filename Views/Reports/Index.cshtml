@{
    ViewData["Title"] = "Reports";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Reports</h1>
        <p class="page-subtitle">Select a report type to get started</p>
    </div>
</div>

<div class="report-cards-grid">

    <a href="/Reports/BusinessDashboard" class="report-card">
        <div class="report-card-icon" style="background:rgba(59,130,246,0.12);color:#3b82f6;">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>
            </svg>
        </div>
        <div class="report-card-body">
            <h3>Business Dashboard</h3>
            <p>Live overview of revenue, profit, invoice status, quote conversion rate, and business health for any date range.</p>
            <ul class="report-card-features">
                <li>Revenue vs. profit over time</li>
                <li>Invoice status breakdown</li>
                <li>Quote conversion funnel</li>
                <li>Repeat client rate & overdue aging</li>
            </ul>
        </div>
        <div class="report-card-arrow">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </div>
    </a>

    <a href="/Reports/ClientReport" class="report-card">
        <div class="report-card-icon" style="background:rgba(168,85,247,0.12);color:#a855f7;">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
            </svg>
        </div>
        <div class="report-card-body">
            <h3>Client Report</h3>
            <p>Deep dive into a single client's full history — every event, invoice, quote, discount given, and payment behaviour over any period.</p>
            <ul class="report-card-features">
                <li>All events & invoices in period</li>
                <li>Total discounts given & discount %</li>
                <li>Payment timing (on time vs. late)</li>
                <li>Lifetime value & average spend per event</li>
            </ul>
        </div>
        <div class="report-card-arrow">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </div>
    </a>

    <a href="/Reports/PeriodSnapshot" class="report-card">
        <div class="report-card-icon" style="background:rgba(34,197,94,0.12);color:#22c55e;">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>
            </svg>
        </div>
        <div class="report-card-body">
            <h3>Period Snapshot</h3>
            <p>Printable business summary for any period — ideal for sharing with your accountant, bank, or for end-of-month review.</p>
            <ul class="report-card-features">
                <li>P&amp;L summary (revenue, costs, profit)</li>
                <li>Top 5 clients by revenue</li>
                <li>Month-by-month breakdown table</li>
                <li>Outstanding receivables &amp; overdue summary</li>
            </ul>
        </div>
        <div class="report-card-arrow">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </div>
    </a>

</div>

@section Styles {
<style>
.report-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 20px;
    margin-top: 8px;
}
.report-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.15s;
    position: relative;
}
.report-card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
}
.report-card-icon {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.report-card-body h3 {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 6px;
}
.report-card-body p {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin: 0 0 12px;
    line-height: 1.5;
}
.report-card-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
}
.report-card-features li {
    font-size: 0.8rem;
    color: var(--text-muted);
    padding-left: 14px;
    position: relative;
}
.report-card-features li::before {
    content: "–";
    position: absolute;
    left: 0;
    color: var(--text-faint, #4b5563);
}
.report-card-arrow {
    position: absolute;
    top: 28px;
    right: 28px;
    color: var(--text-muted);
    opacity: 0;
    transition: opacity 0.2s;
}
.report-card:hover .report-card-arrow { opacity: 1; }
</style>
}
