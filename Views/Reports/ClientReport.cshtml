@model KiefProductions.ViewModels.ClientReportViewModel
@{
    ViewData["Title"] = "Client Report";
}

<div class="page-header" style="flex-wrap:wrap;gap:12px;">
    <div>
        <div class="breadcrumb">
            <a href="/Reports">Reports</a>
            <span>/</span>
            <span>Client Report</span>
        </div>
        <h1 class="page-title">Client Report</h1>
    </div>
</div>

<!-- Parameters Form -->
<div class="card" style="padding:24px;margin-bottom:24px;">
    <h3 class="section-title" style="margin-bottom:16px;">Report Parameters</h3>
    <form method="get" style="display:flex;gap:16px;align-items:flex-end;flex-wrap:wrap;">
        <div class="form-group" style="min-width:220px;flex:1;">
            <label class="form-label">Client</label>
            <select name="clientId" class="form-control">
                <option value="">— Select a client —</option>
                @foreach (var c in Model.AllClients)
                {
                    <option value="@c.Id" selected="@(c.Id == Model.ClientId ? "selected" : null)">
                        @c.FullName @(c.BusinessName != null ? $"({c.BusinessName})" : "")
                    </option>
                }
            </select>
        </div>
        <div class="form-group" style="margin:0;">
            <label class="form-label">From</label>
            <input type="date" name="startDate" class="form-control" style="width:150px;"
                   value="@Model.StartDate.ToString("yyyy-MM-dd")" />
        </div>
        <div class="form-group" style="margin:0;">
            <label class="form-label">To</label>
            <input type="date" name="endDate" class="form-control" style="width:150px;"
                   value="@Model.EndDate.ToString("yyyy-MM-dd")" />
        </div>
        <button type="submit" class="btn btn-primary">Generate Report</button>
        @if (Model.HasData)
        {
            <a href="/Reports/ClientReport?clientId=@Model.ClientId&startDate=@Model.StartDate.ToString("yyyy-MM-dd")&endDate=@Model.EndDate.ToString("yyyy-MM-dd")&exportPdf=true"
               class="btn btn-secondary">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                Export PDF
            </a>
        }
    </form>
</div>

@if (!Model.HasData)
{
    <div class="empty-state">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <p>Select a client and date range above to generate the report.</p>
    </div>
}
else
{
    <!-- Client Header -->
    <div class="card" style="padding:24px;margin-bottom:20px;">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:12px;">
            <div>
                <h2 style="font-size:1.3rem;font-weight:700;margin:0 0 4px;">@Model.Client?.FullName</h2>
                @if (Model.Client?.BusinessName != null)
                {
                    <div style="color:var(--text-muted);font-size:0.9rem;">@Model.Client.BusinessName</div>
                }
                <div style="color:var(--text-muted);font-size:0.85rem;margin-top:4px;">
                    @if (Model.Client?.Email != null) { <span>@Model.Client.Email</span> }
                    @if (Model.Client?.Phone != null) { <span style="margin-left:12px;">@Model.Client.Phone</span> }
                </div>
            </div>
            <div style="text-align:right;">
                <div style="font-size:0.78rem;color:var(--text-muted);">Report Period</div>
                <div style="font-weight:600;">@Model.StartDate.ToString("d MMM yyyy") — @Model.EndDate.ToString("d MMM yyyy")</div>
                @if (Model.RelationshipSince.HasValue)
                {
                    <div style="font-size:0.8rem;color:var(--text-muted);margin-top:4px;">Client since @Model.RelationshipSince.Value.ToString("MMM yyyy")</div>
                }
            </div>
        </div>
    </div>

    <!-- Summary KPIs -->
    <div class="stats-grid" style="grid-template-columns:repeat(auto-fill,minmax(170px,1fr));margin-bottom:20px;">
        <div class="stat-card">
            <div class="stat-label">Total Invoiced</div>
            <div class="stat-value">R @Model.TotalInvoicedInPeriod.ToString("N2")</div>
            <div class="stat-sub">in period</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Total Paid</div>
            <div class="stat-value" style="color:#22c55e;">R @Model.TotalPaidInPeriod.ToString("N2")</div>
            <div class="stat-sub">collected</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Outstanding</div>
            <div class="stat-value" style="color:@(Model.TotalOutstandingInPeriod > 0 ? "#f59e0b" : "inherit");">
                R @Model.TotalOutstandingInPeriod.ToString("N2")
            </div>
            <div class="stat-sub">balance due</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Discounts Given</div>
            <div class="stat-value" style="color:#a855f7;">R @Model.TotalDiscountsGiven.ToString("N2")</div>
            <div class="stat-sub">@Model.DiscountPercentage% of gross</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Events in Period</div>
            <div class="stat-value">@Model.TotalEventsInPeriod</div>
            <div class="stat-sub">@Model.TotalEventsAllTime all-time</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Lifetime Value</div>
            <div class="stat-value">R @Model.LifetimeValue.ToString("N2")</div>
            <div class="stat-sub">total paid all-time</div>
        </div>
    </div>

    <!-- Payment behaviour & avg spend -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;" class="two-col-grid">
        <div class="card" style="padding:20px;">
            <h3 class="section-title" style="margin-bottom:14px;">Payment Behaviour</h3>
            <div class="kpi-list">
                <div class="kpi-row">
                    <span>Avg Days to Payment</span>
                    <strong>@Model.AverageDaysToPayment days</strong>
                </div>
                <div class="kpi-row">
                    <span>Paid On Time</span>
                    <strong style="color:#22c55e;">@Model.InvoicesPaidOnTime invoices</strong>
                </div>
                <div class="kpi-row">
                    <span>Paid Late</span>
                    <strong style="color:@(Model.InvoicesPaidLate > 0 ? "#ef4444" : "inherit");">@Model.InvoicesPaidLate invoices</strong>
                </div>
                <div class="kpi-row">
                    <span>Avg Spend per Event</span>
                    <strong>R @Model.AverageSpendPerEvent.ToString("N2")</strong>
                </div>
            </div>
        </div>
        <div class="card" style="padding:20px;">
            <h3 class="section-title" style="margin-bottom:14px;">Discount Summary</h3>
            <div class="kpi-list">
                <div class="kpi-row">
                    <span>Gross Value (before discount)</span>
                    <strong>R @Model.TotalGrossValue.ToString("N2")</strong>
                </div>
                <div class="kpi-row">
                    <span>Total Discounts Given</span>
                    <strong style="color:#a855f7;">– R @Model.TotalDiscountsGiven.ToString("N2")</strong>
                </div>
                <div class="kpi-row">
                    <span>Net Invoiced</span>
                    <strong>R @Model.TotalInvoicedInPeriod.ToString("N2")</strong>
                </div>
                <div class="kpi-row">
                    <span>Discount Rate</span>
                    <strong>@Model.DiscountPercentage%</strong>
                </div>
            </div>
        </div>
    </div>

    <!-- Invoices table -->
    @if (Model.Invoices.Any())
    {
        <div class="card" style="padding:24px;margin-bottom:20px;">
            <h3 class="section-title" style="margin-bottom:16px;">Invoices in Period</h3>
            <div class="table-wrapper">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Invoice #</th>
                            <th>Issued</th>
                            <th>Due</th>
                            <th>Subtotal</th>
                            <th>Discount</th>
                            <th>Total</th>
                            <th>Paid</th>
                            <th>Balance</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in Model.Invoices)
                        {
                            <tr>
                                <td><a href="/Invoices/Details/@inv.Id">@inv.InvoiceNumber</a></td>
                                <td>@inv.DateIssued.ToString("d MMM yyyy")</td>
                                <td>@inv.DueDate.ToString("d MMM yyyy")</td>
                                <td>R @inv.Subtotal.ToString("N2")</td>
                                <td style="color:@(inv.Discount > 0 ? "#a855f7" : "inherit");">
                                    @(inv.Discount > 0 ? $"– R {inv.Discount:N2}" : "—")
                                </td>
                                <td><strong>R @inv.Total.ToString("N2")</strong></td>
                                <td style="color:#22c55e;">R @inv.AmountPaid.ToString("N2")</td>
                                <td style="color:@(inv.BalanceDue > 0 ? "#f59e0b" : "inherit");">
                                    R @inv.BalanceDue.ToString("N2")
                                </td>
                                <td>
                                    <span class="badge @GetInvoiceBadge(inv.Status)">@inv.Status</span>
                                </td>
                            </tr>
                            @if (inv.Payments.Any())
                            {
                                <tr style="background:var(--bg-surface);">
                                    <td colspan="9" style="padding:8px 16px;">
                                        <div style="font-size:0.78rem;color:var(--text-muted);display:flex;gap:16px;flex-wrap:wrap;">
                                            <span style="font-weight:600;">Payments:</span>
                                            @foreach (var p in inv.Payments)
                                            {
                                                <span>@p.PaymentDate.ToString("d MMM yyyy") — R @p.Amount.ToString("N2") @(p.Method != null ? $"({p.Method})" : "")</span>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Events table -->
    @if (Model.Events.Any())
    {
        <div class="card" style="padding:24px;margin-bottom:20px;">
            <h3 class="section-title" style="margin-bottom:16px;">Events in Period</h3>
            <div class="table-wrapper">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Event</th>
                            <th>Date</th>
                            <th>Venue</th>
                            <th>Status</th>
                            <th>Revenue</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model.Events)
                        {
                            <tr>
                                <td><strong>@e.EventName</strong></td>
                                <td>@e.EventDate.ToString("d MMM yyyy")</td>
                                <td>@(e.Venue ?? "—")</td>
                                <td><span class="badge @GetEventBadge(e.Status)">@e.Status</span></td>
                                <td>@(e.Revenue > 0 ? $"R {e.Revenue:N2}" : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Quotes table -->
    @if (Model.Quotes.Any())
    {
        <div class="card" style="padding:24px;margin-bottom:20px;">
            <h3 class="section-title" style="margin-bottom:16px;">Quotes in Period</h3>
            <div class="table-wrapper">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Quote #</th>
                            <th>Issued</th>
                            <th>Subtotal</th>
                            <th>Discount</th>
                            <th>Total</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var q in Model.Quotes)
                        {
                            <tr>
                                <td><a href="/Quotes/Details/@q.Id">@q.QuoteNumber</a></td>
                                <td>@q.DateIssued.ToString("d MMM yyyy")</td>
                                <td>R @q.Subtotal.ToString("N2")</td>
                                <td style="color:@(q.Discount > 0 ? "#a855f7" : "inherit");">
                                    @(q.Discount > 0 ? $"– R {q.Discount:N2}" : "—")
                                </td>
                                <td><strong>R @q.Total.ToString("N2")</strong></td>
                                <td><span class="badge @GetQuoteBadge(q.Status)">@q.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@section Styles {
<style>
.kpi-list { display: flex; flex-direction: column; gap: 10px; }
.kpi-row { display: flex; justify-content: space-between; align-items: center; font-size: 0.875rem; color: var(--text-secondary); border-bottom: 1px solid var(--border); padding-bottom: 10px; }
.kpi-row:last-child { border-bottom: none; padding-bottom: 0; }
.kpi-row strong { color: var(--text-primary); }
@@media (max-width: 860px) { .two-col-grid { grid-template-columns: 1fr !important; } }
</style>
}

@functions {
    string GetInvoiceBadge(string status) => status switch {
        "Paid" => "badge-success",
        "Overdue" => "badge-danger",
        "PartiallyPaid" => "badge-warning",
        "Sent" => "badge-info",
        _ => "badge-secondary"
    };
    string GetEventBadge(string status) => status switch {
        "Completed" => "badge-success",
        "Cancelled" => "badge-danger",
        "InProgress" => "badge-info",
        "Confirmed" => "badge-warning",
        _ => "badge-secondary"
    };
    string GetQuoteBadge(string status) => status switch {
        "Approved" or "Converted" => "badge-success",
        "Rejected" => "badge-danger",
        "Pending" => "badge-warning",
        _ => "badge-secondary"
    };
}
