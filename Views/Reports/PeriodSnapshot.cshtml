@model KiefProductions.ViewModels.PeriodSnapshotViewModel
@{
    ViewData["Title"] = "Period Snapshot";
}

<div class="page-header" style="flex-wrap:wrap;gap:12px;">
    <div>
        <div class="breadcrumb">
            <a href="/Reports">Reports</a>
            <span>/</span>
            <span>Period Snapshot</span>
        </div>
        <h1 class="page-title">Period Snapshot</h1>
    </div>
    <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
        <form method="get" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
            <div class="form-group" style="margin:0;">
                <input type="date" name="startDate" class="form-control" style="width:150px;"
                       value="@Model.StartDate.ToString("yyyy-MM-dd")" />
            </div>
            <span style="color:var(--text-muted);font-size:0.85rem;">to</span>
            <div class="form-group" style="margin:0;">
                <input type="date" name="endDate" class="form-control" style="width:150px;"
                       value="@Model.EndDate.ToString("yyyy-MM-dd")" />
            </div>
            <button type="submit" class="btn btn-primary">Apply</button>
        </form>
        <a href="/Reports/PeriodSnapshot?startDate=@Model.StartDate.ToString("yyyy-MM-dd")&endDate=@Model.EndDate.ToString("yyyy-MM-dd")&exportPdf=true"
           class="btn btn-secondary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Export PDF
        </a>
    </div>
</div>

<p style="color:var(--text-muted);font-size:0.85rem;margin-bottom:24px;">
    Period: <strong>@Model.StartDate.ToString("d MMM yyyy")</strong> — <strong>@Model.EndDate.ToString("d MMM yyyy")</strong>
</p>

<!-- P&L Summary -->
<div class="card" style="padding:24px;margin-bottom:20px;">
    <h3 class="section-title" style="margin-bottom:16px;">Profit &amp; Loss Summary</h3>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:16px;">
        <div class="snapshot-kpi">
            <div class="snapshot-kpi-label">Total Revenue</div>
            <div class="snapshot-kpi-value">R @Model.TotalRevenue.ToString("N2")</div>
            <div class="snapshot-kpi-sub">from paid invoices</div>
        </div>
        <div class="snapshot-kpi">
            <div class="snapshot-kpi-label">Total Costs</div>
            <div class="snapshot-kpi-value" style="color:#ef4444;">R @Model.TotalCosts.ToString("N2")</div>
            <div class="snapshot-kpi-sub">gear + expenses</div>
        </div>
        <div class="snapshot-kpi" style="border-top:2px solid @(Model.NetProfit >= 0 ? "#22c55e" : "#ef4444");">
            <div class="snapshot-kpi-label">Net Profit</div>
            <div class="snapshot-kpi-value" style="color:@(Model.NetProfit >= 0 ? "#22c55e" : "#ef4444");">
                R @Model.NetProfit.ToString("N2")
            </div>
            <div class="snapshot-kpi-sub">@Model.ProfitMarginPercent% margin</div>
        </div>
        <div class="snapshot-kpi">
            <div class="snapshot-kpi-label">Total Invoiced</div>
            <div class="snapshot-kpi-value">R @Model.TotalInvoiced.ToString("N2")</div>
            <div class="snapshot-kpi-sub">all invoices issued</div>
        </div>
        <div class="snapshot-kpi">
            <div class="snapshot-kpi-label">Total Collected</div>
            <div class="snapshot-kpi-value" style="color:#22c55e;">R @Model.TotalCollected.ToString("N2")</div>
            <div class="snapshot-kpi-sub">payments received</div>
        </div>
        <div class="snapshot-kpi">
            <div class="snapshot-kpi-label">Outstanding</div>
            <div class="snapshot-kpi-value" style="color:@(Model.OutstandingReceivables > 0 ? "#f59e0b" : "inherit");">
                R @Model.OutstandingReceivables.ToString("N2")
            </div>
            <div class="snapshot-kpi-sub">@(Model.OverdueCount > 0 ? $"incl. {Model.OverdueCount} overdue" : "no overdue")</div>
        </div>
    </div>
</div>

<!-- Events & Quotes row -->
<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;" class="two-col-grid">
    <div class="card" style="padding:20px;">
        <h3 class="section-title" style="margin-bottom:14px;">Events</h3>
        <div class="kpi-list">
            <div class="kpi-row"><span>Total Events</span><strong>@Model.TotalEvents</strong></div>
            <div class="kpi-row"><span>Completed</span><strong style="color:#22c55e;">@Model.CompletedEvents</strong></div>
            <div class="kpi-row"><span>Cancelled</span><strong style="color:@(Model.CancelledEvents > 0 ? "#ef4444" : "inherit");">@Model.CancelledEvents</strong></div>
            <div class="kpi-row">
                <span>Completion Rate</span>
                <strong>@(Model.TotalEvents > 0 ? Math.Round((decimal)Model.CompletedEvents / Model.TotalEvents * 100, 1) : 0)%</strong>
            </div>
        </div>
    </div>
    <div class="card" style="padding:20px;">
        <h3 class="section-title" style="margin-bottom:14px;">Quotes</h3>
        <div class="kpi-list">
            <div class="kpi-row"><span>Total Quotes</span><strong>@Model.TotalQuotes</strong></div>
            <div class="kpi-row"><span>Total Quoted Value</span><strong>R @Model.TotalQuotedValue.ToString("N2")</strong></div>
            <div class="kpi-row"><span>Converted</span><strong style="color:#22c55e;">@Model.ConvertedQuotes</strong></div>
            <div class="kpi-row"><span>Conversion Rate</span><strong>@Model.ConversionRate%</strong></div>
        </div>
    </div>
</div>

<!-- Overdue alert -->
@if (Model.OverdueCount > 0)
{
    <div class="alert alert-danger" style="margin-bottom:20px;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <strong>@Model.OverdueCount overdue @(Model.OverdueCount == 1 ? "invoice" : "invoices")</strong> totalling
        <strong>R @Model.OverdueAmount.ToString("N2")</strong> — requires follow-up.
    </div>
}

<!-- Top Clients -->
@if (Model.TopClients.Any())
{
    <div class="card" style="padding:24px;margin-bottom:20px;">
        <h3 class="section-title" style="margin-bottom:16px;">Top Clients by Revenue</h3>
        <div class="table-wrapper">
            <table class="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Client</th>
                        <th>Invoices</th>
                        <th>Events</th>
                        <th>Revenue</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.TopClients.Count; i++)
                    {
                        var c = Model.TopClients[i];
                        <tr>
                            <td style="color:var(--text-muted);">@(i + 1)</td>
                            <td>
                                <strong>@c.Name</strong>
                                @if (c.BusinessName != null) { <div style="font-size:0.8rem;color:var(--text-muted);">@c.BusinessName</div> }
                            </td>
                            <td>@c.InvoiceCount</td>
                            <td>@c.EventCount</td>
                            <td><strong>R @c.Revenue.ToString("N2")</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Monthly Breakdown -->
@if (Model.MonthlyBreakdown.Any())
{
    <div class="card" style="padding:24px;margin-bottom:20px;">
        <h3 class="section-title" style="margin-bottom:16px;">Month-by-Month Breakdown</h3>
        <div class="table-wrapper">
            <table class="table">
                <thead>
                    <tr>
                        <th>Month</th>
                        <th>Revenue</th>
                        <th>Costs</th>
                        <th>Profit</th>
                        <th>Margin</th>
                        <th>Events</th>
                        <th>Invoices</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.MonthlyBreakdown)
                    {
                        var margin = m.Revenue > 0 ? Math.Round(m.Profit / m.Revenue * 100, 1) : 0;
                        <tr>
                            <td><strong>@m.Month @m.Year</strong></td>
                            <td>R @m.Revenue.ToString("N2")</td>
                            <td>R @m.Costs.ToString("N2")</td>
                            <td style="color:@(m.Profit >= 0 ? "#22c55e" : "#ef4444");">
                                R @m.Profit.ToString("N2")
                            </td>
                            <td style="color:@(margin >= 0 ? "#22c55e" : "#ef4444");">@margin%</td>
                            <td>@m.EventCount</td>
                            <td>@m.InvoiceCount</td>
                        </tr>
                    }
                    <!-- Totals row -->
                    <tr style="border-top:2px solid var(--border);font-weight:600;">
                        <td>Total</td>
                        <td>R @Model.TotalRevenue.ToString("N2")</td>
                        <td>R @Model.TotalCosts.ToString("N2")</td>
                        <td style="color:@(Model.NetProfit >= 0 ? "#22c55e" : "#ef4444");">R @Model.NetProfit.ToString("N2")</td>
                        <td style="color:@(Model.ProfitMarginPercent >= 0 ? "#22c55e" : "#ef4444");">@Model.ProfitMarginPercent%</td>
                        <td>@Model.TotalEvents</td>
                        <td>@Model.MonthlyBreakdown.Sum(x => x.InvoiceCount)</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
}

@section Styles {
<style>
.snapshot-kpi { background: var(--bg-surface); border-radius: var(--radius-md); padding: 16px; border-top: 2px solid var(--border); }
.snapshot-kpi-label { font-size: 0.78rem; color: var(--text-muted); margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.04em; }
.snapshot-kpi-value { font-size: 1.3rem; font-weight: 700; color: var(--text-primary); }
.snapshot-kpi-sub { font-size: 0.75rem; color: var(--text-muted); margin-top: 2px; }
.kpi-list { display: flex; flex-direction: column; gap: 10px; }
.kpi-row { display: flex; justify-content: space-between; align-items: center; font-size: 0.875rem; color: var(--text-secondary); border-bottom: 1px solid var(--border); padding-bottom: 10px; }
.kpi-row:last-child { border-bottom: none; padding-bottom: 0; }
.kpi-row strong { color: var(--text-primary); }
@@media (max-width: 860px) { .two-col-grid { grid-template-columns: 1fr !important; } }
</style>
}
