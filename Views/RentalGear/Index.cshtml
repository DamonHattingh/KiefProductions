@model IEnumerable<KiefProductions.Models.RentalGear>
@{ ViewData["Title"] = "Rental Gear"; }

<div class="page-header">
    <div class="page-header-left">
        <h1>Rental Gear</h1>
        <p>@Model.Count() item@(Model.Count() == 1 ? "" : "s") — hired equipment</p>
    </div>
    <div class="d-flex gap-2">
        <form method="get" class="search-bar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" name="search" class="form-control" placeholder="Search rental gear..." value="@ViewBag.Search" />
        </form>
        <a href="/RentalGear/Create" class="btn btn-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Add Rental Gear
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
            <h3>No rental gear added yet</h3>
            <p>Add hired equipment with supplier and cost info</p>
            <a href="/RentalGear/Create" class="btn btn-primary">Add Rental Gear</a>
        </div>
    </div>
}
else
{
    <div class="table-wrapper">
        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Type</th>
                    <th>Supplier</th>
                    <th>Market Price</th>
                    <th>Our Cost</th>
                    <th>Margin</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var gear in Model)
                {
                    var margin = gear.MarketPrice > 0 ? ((gear.MarketPrice - gear.OurCost) / gear.MarketPrice * 100) : 0;
                    <tr>
                        <td style="font-weight:500;">@gear.Name</td>
                        <td class="muted">@gear.ProductType.Category.Name</td>
                        <td class="muted">@gear.ProductType.Name</td>
                        <td class="muted">@(gear.Supplier ?? "—")</td>
                        <td style="font-family:'Outfit',sans-serif;font-weight:600;">R @gear.MarketPrice.ToString("N2")</td>
                        <td class="muted">R @gear.OurCost.ToString("N2")</td>
                        <td style="color:@(margin >= 0 ? "var(--green)" : "var(--red)");font-weight:600;">@margin.ToString("N1")%</td>
                        <td>
                            <div class="table-actions">
                                <a href="/RentalGear/Edit/@gear.Id" class="btn btn-ghost btn-sm" data-tooltip="Edit">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                </a>
                                <form asp-action="Delete" asp-route-id="@gear.Id" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm" data-confirm="Delete this rental gear?" data-tooltip="Delete">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/></svg>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
