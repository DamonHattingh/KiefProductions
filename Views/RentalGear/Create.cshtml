@model KiefProductions.Models.RentalGear
@{ ViewData["Title"] = "Add Rental Gear"; }

<div class="breadcrumb">
    <a href="/RentalGear">Rental Gear</a>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
    <span class="current">Add Rental Gear</span>
</div>

<div style="max-width:640px;">
    <div class="card">
        <div class="card-header"><h2>Add Rental Gear</h2></div>
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="card-body">
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Category <span class="required">*</span></label>
                        <select id="categorySelect" class="form-select" onchange="loadTypes(this.value)">
                            <option value="">Select Category</option>
                            @foreach (var cat in ViewBag.Categories)
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Product Type <span class="required">*</span></label>
                        <select asp-for="ProductTypeId" id="typeSelect" class="form-select">
                            <option value="">Select Type</option>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Item Name <span class="required">*</span></label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Robe BMFL Follow Spot" />
                    <span asp-validation-for="Name" class="form-error"></span>
                </div>
                <div class="form-group">
                    <label class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="2" placeholder="Brief description"></textarea>
                </div>
                <div class="form-group">
                    <label class="form-label">Supplier</label>
                    <input asp-for="Supplier" class="form-control" placeholder="Supplier / rental company name" />
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Market Price (R)</label>
                        <div class="input-group">
                            <span class="input-group-text">R</span>
                            <input asp-for="MarketPrice" type="number" class="form-control currency-input" step="0.01" min="0" placeholder="0.00" />
                        </div>
                        <span class="form-hint">Price charged to client</span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Our Cost (R)</label>
                        <div class="input-group">
                            <span class="input-group-text">R</span>
                            <input asp-for="OurCost" type="number" class="form-control currency-input" step="0.01" min="0" placeholder="0.00" />
                        </div>
                        <span class="form-hint">What we pay the supplier</span>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <button type="submit" class="btn btn-primary">Save Rental Gear</button>
                <a href="/RentalGear" class="btn btn-ghost">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        async function loadTypes(categoryId) {
            const select = document.getElementById('typeSelect');
            select.innerHTML = '<option value="">Loading...</option>';
            if (!categoryId) { select.innerHTML = '<option value="">Select Type</option>'; return; }
            const res = await fetch(`/RentalGear/GetProductTypes?categoryId=${categoryId}`);
            const types = await res.json();
            select.innerHTML = '<option value="">Select Type</option>' +
                types.map(t => `<option value="${t.id}">${t.name}</option>`).join('');
        }
    </script>
}
