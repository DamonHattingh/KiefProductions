@model IEnumerable<KiefProductions.Models.Package>
@{ ViewData["Title"] = "Packages"; }

<div class="page-header">
    <div class="page-header-left">
        <h1>Packages</h1>
        <p>@Model.Count() package@(Model.Count() == 1 ? "" : "s")</p>
    </div>
    <a href="/Packages/Create" class="btn btn-primary">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        New Package
    </a>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="16.5" y1="9.4" x2="7.5" y2="4.21"/><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
            <h3>No packages yet</h3>
            <p>Bundle your gear into reusable packages for faster quoting</p>
            <a href="/Packages/Create" class="btn btn-primary">Create Package</a>
        </div>
    </div>
}
else
{
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:16px;">
        @foreach (var pkg in Model)
        {
            <div class="card">
                <div class="card-header">
                    <div>
                        <h3 style="margin-bottom:2px;">@pkg.Name</h3>
                        @if (!pkg.IsActive)
                        {
                            <span class="badge" style="background:var(--bg-hover);color:var(--text-muted);">Inactive</span>
                        }
                    </div>
                    <div style="font-family:'Outfit',sans-serif;font-size:20px;font-weight:700;color:var(--accent);">R @pkg.BasePrice.ToString("N2")</div>
                </div>
                <div class="card-body" style="padding:12px 16px;">
                    @if (pkg.PackageItems.Any())
                    {
                        <div style="display:flex;flex-direction:column;gap:6px;">
                            @foreach (var item in pkg.PackageItems)
                            {
                                <div style="display:flex;align-items:center;gap:8px;font-size:13px;">
                                    <span style="background:var(--bg-hover);color:var(--text-secondary);border-radius:4px;padding:1px 7px;font-family:'Outfit',sans-serif;font-weight:600;font-size:12px;min-width:28px;text-align:center;">×@item.Quantity</span>
                                    @if (item.GearId.HasValue)
                                    {
                                        <span style="color:var(--text-primary);">@item.Gear?.Name</span>
                                        <span style="color:var(--text-muted);font-size:11px;">@item.Gear?.ProductType?.Name</span>
                                    }
                                    else
                                    {
                                        <span style="color:var(--text-secondary);">@item.CustomDescription</span>
                                        <span class="badge" style="background:var(--blue-bg);color:var(--blue);font-size:10px;">Custom</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p style="color:var(--text-muted);font-size:13px;margin:0;">No items added</p>
                    }
                </div>
                <div class="card-footer" style="justify-content:flex-end;gap:8px;">
                    <a href="/Packages/Edit/@pkg.Id" class="btn btn-secondary btn-sm">Edit</a>
                    <form asp-action="Delete" asp-route-id="@pkg.Id" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger btn-sm" data-confirm="Delete package '@pkg.Name'?">Delete</button>
                    </form>
                </div>
            </div>
        }
    </div>
}
