@using KiefProductions.Controllers
@model EditUserViewModel
@{ ViewData["Title"] = "Edit User"; }

<div class="breadcrumb">
    <a href="/Users">Users</a>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
    <span class="current">Edit @Model.Email</span>
</div>

<div style="max-width:520px;">
    <div class="card">
        <div class="card-header"><h2>Edit User</h2></div>
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="form-group">
                    <label class="form-label">Email Address</label>
                    <input asp-for="Email" type="email" class="form-control" />
                    <span asp-validation-for="Email" class="form-error"></span>
                </div>
                <div class="form-group">
                    <label class="form-label">Role</label>
                    <select asp-for="Role" class="form-select">
                        <option value="">No Role</option>
                        <option value="Admin">Admin — full access</option>
                        <option value="Staff">Staff — standard access</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">New Password</label>
                    <input asp-for="NewPassword" type="password" class="form-control"
                           placeholder="Leave blank to keep current password" />
                    <span class="form-hint">Only fill this in if you want to change the password</span>
                </div>
            </div>
            <div class="card-footer">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a href="/Users" class="btn btn-ghost">Cancel</a>
            </div>
        </form>
    </div>
</div>
