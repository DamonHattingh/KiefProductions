<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Kief Productions</title>

    <link rel="icon" type="image/png" href="~/images/favicon/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="~/images/favicon/favicon.svg" />
    <link rel="shortcut icon" href="~/images/favicon/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/images/favicon/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Kief Productions" />
    <link rel="manifest" href="~/images/favicon/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">

    <script src="https://unpkg.com/htmx.org@1.9.12"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/dynamic-table.js"></script>
    <script src="~/js/pdf-loading.js"></script>


    <link rel="stylesheet" href="~/css/kief.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app-wrapper">

        <!-- ── Sidebar ──────────────────────────────────────── -->
        <aside class="sidebar">
            <a href="/" class="sidebar-logo">
                <img src="/images/TextWhite.png" height="75px;" />
            </a>

            <nav class="sidebar-nav">
                <a href="/" class="nav-item">
                    @NavIcon("grid")
                    <span>Dashboard</span>
                </a>

                <div class="nav-section-label">Operations</div>

                <a href="/Events" class="nav-item">
                    @NavIcon("calendar")
                    <span>Events</span>
                </a>

                <a href="/Quotes" class="nav-item">
                    @NavIcon("file-text")
                    <span>Quotes</span>
                </a>

                <a href="/Invoices" class="nav-item">
                    @NavIcon("credit-card")
                    <span>Invoices</span>
                </a>

                <a href="/Clients" class="nav-item">
                    @NavIcon("users")
                    <span>Clients</span>
                </a>

                <a href="/VendorDocuments" class="nav-item">
                    @NavIcon("paperclip")
                    <span>Vendor Documents</span>
                </a>

                <a href="/Reports" class="nav-item">
                    @NavIcon("bar-chart")
                    <span>Reports</span>
                </a>

                <div class="nav-section-label">Inventory</div>

                <a href="/Categories" class="nav-item">
                    @NavIcon("tag")
                    <span>Categories</span>
                </a>

                <a href="/Gear" class="nav-item">
                    @NavIcon("tool")
                    <span>Own Gear</span>
                </a>

                <a href="/RentalGear" class="nav-item">
                    @NavIcon("refresh-cw")
                    <span>Rental Gear</span>
                </a>

                <a href="/Packages" class="nav-item">
                    @NavIcon("package")
                    <span>Packages</span>
                </a>

                <div class="nav-section-label">People</div>

                <a href="/Staff" class="nav-item">
                    @NavIcon("user-check")
                    <span>Staff</span>
                </a>

                <a href="/Users" class="nav-item">
                    @NavIcon("shield")
                    <span>Users</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a href="/Identity/Account/Manage" class="nav-item">
                        @NavIcon("settings")
                        <span>Settings</span>
                    </a>
                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post" style="margin:0">
                        <button type="submit" class="nav-item w-100" style="background:none;border:none;cursor:pointer;text-align:left;">
                            @NavIcon("log-out")
                            <span>Logout</span>
                        </button>
                    </form>
                }
                else
                {
                    <a href="/Identity/Account/Login" class="nav-item">
                        @NavIcon("log-in")
                        <span>Login</span>
                    </a>
                }
            </div>
        </aside>

        <!-- ── Main ─────────────────────────────────────────── -->
        <div class="main-content">

            <!-- Top Bar -->
            <header class="topbar">
                <button id="sidebarToggle" class="btn btn-ghost btn-icon" style="display:none;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" /></svg>
                </button>

                <span class="topbar-title">@(ViewData["Title"] ?? "Dashboard")</span>

                <div class="topbar-actions">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="topbar-user">
                            <div class="user-avatar">
                                @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "A")
                            </div>
                            <span>@User.Identity.Name</span>
                        </div>
                    }
                </div>
            </header>

            <!-- Page Content -->
            <main class="page-content">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success" data-auto-dismiss>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5" /></svg>
                        @TempData["Success"]
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger" data-auto-dismiss>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                        @TempData["Error"]
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/js/kief.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@functions {
    IHtmlContent NavIcon(string name)
    {
        var paths = new Dictionary<string, string>
        {
            ["grid"] = "<rect x='3' y='3' width='7' height='7'/><rect x='14' y='3' width='7' height='7'/><rect x='3' y='14' width='7' height='7'/><rect x='14' y='14' width='7' height='7'/>",
            ["calendar"] = "<rect x='3' y='4' width='18' height='18' rx='2'/><line x1='16' y1='2' x2='16' y2='6'/><line x1='8' y1='2' x2='8' y2='6'/><line x1='3' y1='10' x2='21' y2='10'/>",
            ["file-text"] = "<path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'/><polyline points='14 2 14 8 20 8'/><line x1='16' y1='13' x2='8' y2='13'/><line x1='16' y1='17' x2='8' y2='17'/><polyline points='10 9 9 9 8 9'/>",
            ["credit-card"] = "<rect x='1' y='4' width='22' height='16' rx='2'/><line x1='1' y1='10' x2='23' y2='10'/>",
            ["users"] = "<path d='M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2'/><circle cx='9' cy='7' r='4'/><path d='M23 21v-2a4 4 0 0 0-3-3.87'/><path d='M16 3.13a4 4 0 0 1 0 7.75'/>",
            ["tag"] = "<path d='M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z'/><line x1='7' y1='7' x2='7.01' y2='7'/>",
            ["tool"] = "<path d='M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z'/>",
            ["refresh-cw"] = "<polyline points='23 4 23 10 17 10'/><polyline points='1 20 1 14 7 14'/><path d='M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15'/>",
            ["package"] = "<line x1='16.5' y1='9.4' x2='7.5' y2='4.21'/><path d='M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z'/><polyline points='3.27 6.96 12 12.01 20.73 6.96'/><line x1='12' y1='22.08' x2='12' y2='12'/>",
            ["user-check"] = "<path d='M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2'/><circle cx='8.5' cy='7' r='4'/><polyline points='17 11 19 13 23 9'/>",
            ["settings"] = "<circle cx='12' cy='12' r='3'/><path d='M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z'/>",
            ["log-out"] = "<path d='M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4'/><polyline points='16 17 21 12 16 7'/><line x1='21' y1='12' x2='9' y2='12'/>",
            ["log-in"] = "<path d='M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4'/><polyline points='10 17 15 12 10 7'/><line x1='15' y1='12' x2='3' y2='12'/>",
            ["shield"] = "<path d='M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z'/>",
            ["bar-chart"] = "<line x1='18' y1='20' x2='18' y2='10'/><line x1='12' y1='20' x2='12' y2='4'/><line x1='6' y1='20' x2='6' y2='14'/>",
            ["paperclip"] = "<path d='M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48'/>",
        };
        var path = paths.GetValueOrDefault(name, "");
        return new HtmlString($"<svg class='nav-icon' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'>{path}</svg>");
    }
}
