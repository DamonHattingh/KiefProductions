@model KiefProductions.Models.Quote
@{
    ViewData["Title"] = Model.QuoteNumber ?? "Draft Quote";
}

<div class="breadcrumb">
    <a href="/Quotes">Quotes</a>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6" /></svg>
    <span class="current">@(Model.QuoteNumber ?? "Draft")</span>
</div>

<div class="page-header">
    <div class="page-header-left">
        <h1>@(Model.QuoteNumber ?? "Draft Quote")</h1>
        <p>@Model.Client.FullName · @Model.DateIssued.ToString("dd MMM yyyy")</p>
    </div>
    <div class="d-flex gap-2">
@*         <a href="/Quotes/PreviewPdf/@Model.Id" target="_blank">Preview PDF</a>
 *@        <a href="/Quotes/GeneratePdf/@Model.Id" class="btn btn-secondary" target="_blank">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /></svg>
            Export PDF
        </a>
        @if (Model.QuoteType == KiefProductions.Models.QuoteType.FreeText)
        {
            <a href="/Quotes/EditFreeText/@Model.Id" class="btn btn-secondary">Edit</a>
        }
        else
        {
            <a href="/Quotes/Edit/@Model.Id" class="btn btn-secondary">Edit</a>
        }

        <form asp-action="Duplicate" asp-route-id="@Model.Id" method="post" style="display:inline;">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-ghost">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" /><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" /></svg>
                Duplicate
            </button>
        </form>

        <select class="form-select" style="width:160px;" onchange="updateStatus(this.value)">
            @foreach (var statusOption in Enum.GetValues<KiefProductions.Models.QuoteStatus>())
            {
                <option value="@statusOption" selected="@(Model.Status == statusOption)">@statusOption</option>
            }
        </select>
        @if (Model.Status == KiefProductions.Models.QuoteStatus.Approved)
        {
            <form asp-action="ConvertToInvoice" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary" onclick="return confirm('Convert this quote to an invoice?')">
                    Convert to Invoice
                </button>
            </form>
        }
    </div>
</div>

<div class="detail-grid">
    <div>
        <!-- Client + Event -->
        <div class="card mb-3">
            <div class="card-body" style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
                <div>
                    <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:var(--text-muted);margin-bottom:10px;">Client</div>
                    <div class="detail-row"><span class="detail-label">Name</span><span class="detail-value">@Model.Client.FullName</span></div>
                    <div class="detail-row"><span class="detail-label">Email</span><span class="detail-value">@Model.Client.Email</span></div>
                    <div class="detail-row"><span class="detail-label">Phone</span><span class="detail-value">@(Model.Client.Phone ?? "—")</span></div>
                </div>
                @if (Model.Event != null)
                {
                    <div>
                        <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:var(--text-muted);margin-bottom:10px;">Event</div>
                        <div class="detail-row"><span class="detail-label">Name</span><span class="detail-value">@Model.Event.EventName</span></div>
                        <div class="detail-row"><span class="detail-label">Date</span><span class="detail-value">@(Model.Event.EventEndDate.HasValue ? $"{Model.Event.EventDate:dd MMM yyyy} – {Model.Event.EventEndDate:dd MMM yyyy}" : Model.Event.EventDate.ToString("dd MMM yyyy"))</span></div>
                        <div class="detail-row"><span class="detail-label">Venue</span><span class="detail-value">@(Model.Event.Venue ?? "TBC")</span></div>
                        @if (Model.Event.StartTime.HasValue)
                        {
                            <div class="detail-row"><span class="detail-label">Time</span><span class="detail-value">@Model.Event.StartTime?.ToString(@"hh\:mm") — @Model.Event.EndTime?.ToString(@"hh\:mm")</span></div>
                        }
                    </div>
                }
            </div>
        </div>

        @if (Model.QuoteType == KiefProductions.Models.QuoteType.FreeText)
        {
            <!-- Free Text Sections -->
            <div class="card mb-3">
                <div class="card-header"><h3>Sections</h3></div>
                @foreach (var sec in Model.FreeTextSections.OrderBy(s => s.SortOrder))
                {
                    <div style="border-bottom:1px solid var(--border);">
                        <div style="background:var(--bg-elevated);padding:10px 16px;display:flex;justify-content:space-between;align-items:center;">
                            <span style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:var(--orange);">@sec.CategoryName</span>
                            <span style="font-family:'Outfit',sans-serif;font-weight:700;color:var(--orange);">R @((sec.Qty * sec.UnitPrice).ToString("N2"))</span>
                        </div>
                        @if (!string.IsNullOrEmpty(sec.DescriptionHtml))
                        {
                            <div style="margin-left: 16px;padding:14px 16px;font-size:13px;line-height:1.6;color:var(--text-primary);">
                                @Html.Raw(sec.DescriptionHtml)
                            </div>
                        }
                        <div style="padding:10px 16px 14px;display:flex;gap:24px;font-size:12px;color:var(--text-muted);">
                            <span>Qty: <strong style="color:var(--text-primary);">@sec.Qty.ToString("G")</strong></span>
                            <span>Unit Price: <strong style="color:var(--text-primary);">R @sec.UnitPrice.ToString("N2")</strong></span>
                            <span>Cost: <strong style="color:var(--text-primary);">R @sec.Cost.ToString("N2")</strong></span>
                        </div>
                    </div>
                }
                @if (!Model.FreeTextSections.Any())
                {
                    <div style="padding:24px;text-align:center;color:var(--text-muted);font-size:13px;">No sections added yet.</div>
                }
            </div>
        }
        else
        {
            <!-- Line Items -->
            <div class="card mb-3">
                <div class="card-header"><h3>Line Items</h3></div>
                @{
                    var packageItems = Model.LineItems.Where(li => li.ItemType == KiefProductions.Models.LineItemType.Package).ToList();
                    var regularItems = Model.LineItems.Where(li => li.ItemType != KiefProductions.Models.LineItemType.Package && !li.IsExpense);
                    var expenseItems = Model.LineItems.Where(li => li.IsExpense).ToList();
                    var grouped = regularItems.GroupBy(li => li.Category?.Name ?? "Uncategorized");
                }

                <table class="table">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Item</th>
                            <th>Description</th>
                            <th>Price</th>
                            <th>Qty</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pkg in packageItems)
                        {
                            <tr>
                                <td colspan="6" style="background:var(--bg-elevated);font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:var(--purple);padding:8px 16px;">
                                    Bundle
                                </td>
                            </tr>
                            <tr>
                                <td><span class="badge" style="background:var(--purple-bg);color:var(--purple);">Package</span></td>
                                <td style="font-weight:500;">@pkg.ProductName</td>
                                <td class="muted">
                                    @if (pkg.Package != null)
                                    {
                                        @foreach (var pi in pkg.Package.PackageItems)
                                        {
                                            <div style="font-size:12px;">×@pi.Quantity @(pi.Gear?.Name ?? pi.CustomDescription)</div>
                                        }
                                    }
                                </td>
                                <td>R @pkg.UnitPrice.ToString("N2")</td>
                                <td>@pkg.Quantity</td>
                                <td style="font-family:'Outfit',sans-serif;font-weight:600;color:var(--orange);">R @((pkg.Quantity * pkg.UnitPrice).ToString("N2"))</td>
                            </tr>
                        }

                        @foreach (var group in grouped)
                        {
                            <tr>
                                <td colspan="6" style="background:var(--bg-elevated);font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:var(--orange);padding:8px 16px;">
                                    @group.Key
                                </td>
                            </tr>
                            @foreach (var item in group)
                            {
                                <tr>
                                    <td class="muted">@(item.IsRental ? "Rental" : item.ProductType?.Name)</td>
                                    <td style="font-weight:500;">@item.ProductName</td>
                                    <td class="muted">@item.ProductDescription</td>
                                    <td>R @item.UnitPrice.ToString("N2")</td>
                                    <td>@item.Quantity</td>
                                    <td style="font-family:'Outfit',sans-serif;font-weight:600;color:var(--orange);">R @((item.Quantity * item.UnitPrice).ToString("N2"))</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Expenses (internal) -->
            @if (expenseItems.Any())
            {
                <div class="card mb-3">
                    <div class="card-header">
                        <h3 style="color:var(--red);">Internal Expenses</h3>
                        <span style="font-size:12px;color:var(--text-muted);">Not shown on client PDF</span>
                    </div>
                    <table class="table">
                        <thead><tr><th>Description</th><th>Notes</th><th>Qty</th><th>Cost</th><th>Total</th></tr></thead>
                        <tbody>
                            @foreach (var exp in expenseItems)
                            {
                                <tr style="background:rgba(239,68,68,0.03);">
                                    <td style="font-weight:500;">@exp.ProductName</td>
                                    <td class="muted">@exp.ProductDescription</td>
                                    <td>@exp.Quantity</td>
                                    <td>R @((exp.CostPrice ?? 0).ToString("N2"))</td>
                                    <td style="color:var(--red);font-weight:600;">R @((exp.Quantity * (exp.CostPrice ?? 0)).ToString("N2"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>

    <!-- Sidebar -->
    <div>
        <div class="finance-summary mb-3">
            <div class="finance-row">
                <span class="label">Subtotal</span>
                <span class="value">R @Model.Subtotal.ToString("N2")</span>
            </div>
            @if (Model.Discount > 0)
            {
                <div class="finance-row">
                    <span class="label">Discount</span>
                    <span class="value" style="color:var(--red);">−R @Model.Discount.ToString("N2")</span>
                </div>
            }
            <div class="finance-row total-row">
                <span class="label">Total</span>
                <span class="value">R @Model.Total.ToString("N2")</span>
            </div>
        </div>

        @if (Model.ProfitSummary != null)
        {
            <div class="card">
                <div class="card-header"><h3>Profit Analysis</h3></div>
                <div class="card-body" style="padding:0;">
                    <div class="finance-row"><span class="label">Revenue</span><span class="value">R @Model.ProfitSummary.TotalRevenue.ToString("N2")</span></div>
                    <div class="finance-row"><span class="label">Costs</span><span class="value" style="color:var(--red);">R @Model.ProfitSummary.TotalCost.ToString("N2")</span></div>
                    <div class="finance-row"><span class="label">Expenses</span><span class="value" style="color:var(--red);">R @Model.ProfitSummary.TotalExpenses.ToString("N2")</span></div>
                    <div class="finance-row profit-row">
                        <span class="label">Net Profit</span>
                        <span class="value @(Model.ProfitSummary.NetProfit >= 0 ? "positive" : "negative")">R @Model.ProfitSummary.NetProfit.ToString("N2")</span>
                    </div>
                    <div class="finance-row">
                        <span class="label">Margin</span>
                        <span class="value @(Model.ProfitSummary.ProfitMargin >= 0 ? "" : "")">@Model.ProfitSummary.ProfitMargin.ToString("N1")%</span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function updateStatus(status) {
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/Quotes/UpdateStatus';
            form.innerHTML = `<input name="id" value="@Model.Id" /><input name="status" value="${status}" /><input name="__RequestVerificationToken" value="${document.querySelector('[name=__RequestVerificationToken]')?.value ?? ''}" />`;
            document.body.appendChild(form);
            form.submit();
        }
    </script>
}
