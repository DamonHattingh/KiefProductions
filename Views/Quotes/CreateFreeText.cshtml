@model KiefProductions.Models.Quote
@{ ViewData["Title"] = "New Free Text Quote"; }

<div class="breadcrumb">
    <a href="/Quotes">Quotes</a>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
    <span class="current">New Free Text Quote</span>
</div>

<form asp-action="CreateFreeText" method="post" id="quoteForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="SectionsJson" id="sectionsJson" />
    <input type="hidden" name="IsDraft" id="isDraftInput" value="false" />

    <div x-data="freeTextBuilder()" x-init="init()">

        <!-- Top bar -->
        <div class="d-flex align-center gap-2 mb-3">
            <div style="flex:1;">
                <select name="ClientId" class="form-select" style="max-width:300px;" required x-model="clientId">
                    <option value="">Select Client *</option>
                    @foreach (var c in ViewBag.Clients as IEnumerable<KiefProductions.Models.Client> ?? Enumerable.Empty<KiefProductions.Models.Client>())
                    {
                        <option value="@c.Id" selected="@(Model.ClientId == c.Id)">@c.FullName @(c.BusinessName != null ? $"({c.BusinessName})" : "")</option>
                    }
                </select>
            </div>
            <button type="button" class="btn btn-ghost" @@click="saveDraft()">Save Draft</button>
            <button type="button" class="btn btn-primary" @@click="submitQuote()">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/></svg>
                Save Quote
            </button>
        </div>

        <div class="detail-grid">
            <div>
                <!-- Event Details -->
                <div class="card mb-3">
                    <div class="card-header"><h3>Event Details</h3></div>
                    <div class="card-body">
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">Event Name</label>
                                <input name="EventName" type="text" class="form-control" placeholder="e.g. Johnson Wedding" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Event Date</label>
                                <input name="EventDate" type="date" class="form-control" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">Venue</label>
                                <input name="Venue" type="text" class="form-control" placeholder="Venue name" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Schedule</label>
                                <div class="d-flex gap-2">
                                    <input name="StartTime" type="time" class="form-control" />
                                    <input name="EndTime" type="time" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Free Text Sections -->
                <div class="card mb-3">
                    <div class="card-header">
                        <h3>Sections</h3>
                        <button type="button" class="btn btn-secondary btn-sm" @@click="addSection()">+ Add Section</button>
                    </div>

                    <template x-for="(section, idx) in sections" :key="section.id">
                        <div class="builder-section">
                            <!-- Section header -->
                            <div class="builder-section-header">
                                <input type="text"
                                       x-model="section.categoryName"
                                       class="form-control"
                                       style="max-width:320px;font-weight:600;"
                                       placeholder="Section name (e.g. Sound, Lighting, Labour)" />
                                <button type="button" class="btn btn-danger btn-sm btn-icon" @@click="removeSection(idx)">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                </button>
                            </div>

                            <!-- Quill editor -->
                            <div style="padding:0 16px 12px;">
                                <div :id="'quill-editor-' + section.id" style="min-height:120px;background:var(--bg-elevated);border-radius:6px;"></div>
                            </div>

                            <!-- Numeric row -->
                            <div style="display:grid;grid-template-columns:90px 140px 140px 1fr;gap:8px;padding:10px 16px 14px;align-items:center;border-top:1px solid var(--border);">
                                <div>
                                    <div style="font-size:11px;color:var(--text-muted);margin-bottom:4px;">Qty</div>
                                    <input type="number" x-model.number="section.qty" class="form-control form-control-sm" step="0.01" min="0" @@input="recalc()" />
                                </div>
                                <div>
                                    <div style="font-size:11px;color:var(--text-muted);margin-bottom:4px;">Unit Price (R)</div>
                                    <input type="number" x-model.number="section.unitPrice" class="form-control form-control-sm" step="0.01" min="0" @@input="recalc()" />
                                </div>
                                <div>
                                    <div style="font-size:11px;color:var(--text-muted);margin-bottom:4px;">Cost (R)</div>
                                    <input type="number" x-model.number="section.cost" class="form-control form-control-sm" step="0.01" min="0" @@input="recalc()" />
                                </div>
                                <div style="text-align:right;">
                                    <div style="font-size:11px;color:var(--text-muted);margin-bottom:4px;">Section Total</div>
                                    <div style="font-family:'Outfit',sans-serif;font-weight:700;font-size:16px;color:var(--orange);"
                                         x-text="'R ' + (section.qty * section.unitPrice).toFixed(2)"></div>
                                </div>
                            </div>
                        </div>
                    </template>

                    <div x-show="sections.length === 0" style="padding:30px;text-align:center;color:var(--text-muted);font-size:13px;">
                        No sections yet — click <strong>+ Add Section</strong> above to get started
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div>
                <div class="finance-summary mb-3">
                    <div class="finance-row">
                        <span class="label">Subtotal</span>
                        <span class="value" x-text="'R ' + subtotal.toFixed(2)"></span>
                    </div>
                    <div class="finance-row">
                        <span class="label">Discount</span>
                        <div class="input-group" style="width:120px;">
                            <span class="input-group-text">R</span>
                            <input type="number" name="Discount" x-model.number="discount" class="form-control form-control-sm" step="0.01" min="0" @@input="recalc()" />
                        </div>
                    </div>
                    <div class="finance-row total-row">
                        <span class="label">Total</span>
                        <span class="value" x-text="'R ' + total.toFixed(2)"></span>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header" style="cursor:pointer;" @@click="showProfit = !showProfit">
                        <h3>Profit Analysis</h3>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" :style="showProfit ? 'transform:rotate(180deg)' : ''"><polyline points="6 9 12 15 18 9"/></svg>
                    </div>
                    <div x-show="showProfit" class="card-body" style="padding:0;">
                        <div class="finance-row"><span class="label">Revenue</span><span class="value" x-text="'R ' + revenue.toFixed(2)"></span></div>
                        <div class="finance-row"><span class="label">Costs</span><span class="value" style="color:var(--red);" x-text="'R ' + totalCost.toFixed(2)"></span></div>
                        <div class="finance-row profit-row">
                            <span class="label">Net Profit</span>
                            <span class="value" :class="netProfit >= 0 ? 'positive' : 'negative'" x-text="'R ' + netProfit.toFixed(2)"></span>
                        </div>
                        <div class="finance-row">
                            <span class="label">Margin</span>
                            <span class="value" x-text="profitMargin.toFixed(1) + '%'"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</form>

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/quill@2/dist/quill.snow.css" rel="stylesheet" />
    <style>
        .ql-toolbar { background: var(--bg-elevated); border-color: var(--border) !important; border-radius: 6px 6px 0 0; }
        .ql-container { background: var(--bg-elevated); border-color: var(--border) !important; border-radius: 0 0 6px 6px; font-size: 13px; color: var(--text-primary); }
        .ql-editor { min-height: 100px; }
        .ql-editor.ql-blank::before { color: var(--text-muted); font-style: normal; }
        .ql-stroke { stroke: var(--text-muted) !important; }
        .ql-fill { fill: var(--text-muted) !important; }
        .ql-picker-label { color: var(--text-muted) !important; }
        .ql-toolbar button:hover .ql-stroke, .ql-toolbar button.ql-active .ql-stroke { stroke: var(--orange) !important; }
        .ql-toolbar button:hover .ql-fill, .ql-toolbar button.ql-active .ql-fill { fill: var(--orange) !important; }
        .form-control-sm { padding: 5px 10px; font-size: 12.5px; }
        [x-cloak] { display: none !important; }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/quill@2/dist/quill.js"></script>
    <script>
        function freeTextBuilder() {
            return {
                sections: [],
                quillInstances: {},
                nextId: 1,
                clientId: '@Model.ClientId',
                discount: 0,
                subtotal: 0,
                total: 0,
                revenue: 0,
                totalCost: 0,
                netProfit: 0,
                profitMargin: 0,
                showProfit: false,

                init() {
                    // nothing to preload on create
                },

                addSection() {
                    const id = this.nextId++;
                    this.sections.push({ id, categoryName: '', descriptionHtml: '', qty: 1, unitPrice: 0, cost: 0 });
                    this.$nextTick(() => this.initQuill(id, ''));
                },

                        initQuill(id, initialHtml) {

            const el = document.getElementById('quill-editor-' + id);
            if (!el || this.quillInstances[id]) return;

            const quill = new Quill(el, {
                theme: 'snow',
                placeholder: 'Describe what is included in this section...',
                modules: {
                    toolbar: [
                        ['bold', 'italic', 'underline'],
                        [{ list: 'ordered' }, { list: 'bullet' }],
                        [{ indent: '-1' }, { indent: '+1' }],
                        ['clean']
                    ]
                }
            });

            if (initialHtml) {
                quill.clipboard.dangerouslyPasteHTML(initialHtml);
            }

            quill.on('text-change', () => {
                const sec = this.sections.find(s => s.id === id);
                if (sec) sec.descriptionHtml = quill.root.innerHTML;
            });

            this.quillInstances[id] = quill;
        },

                removeSection(idx) {
                    const sec = this.sections[idx];
                    delete this.quillInstances[sec.id];
                    this.sections.splice(idx, 1);
                    this.recalc();
                },

                recalc() {
                    let sub = 0, costs = 0;
                    this.sections.forEach(s => {
                        sub += (s.qty || 0) * (s.unitPrice || 0);
                        costs += s.cost || 0;
                    });
                    this.subtotal = sub;
                    this.total = Math.max(sub - (this.discount || 0), 0);
                    this.revenue = sub;
                    this.totalCost = costs;
                    this.netProfit = sub - costs;
                    this.profitMargin = sub > 0 ? (this.netProfit / sub * 100) : 0;
                },

                        buildSections() {

            function normalizeQuillLists(html) {

                const temp = document.createElement('div');
                temp.innerHTML = html;

                temp.querySelectorAll('li[data-list="bullet"]').forEach(li => {

                    const ul = document.createElement('ul');

                    if (li.parentNode.tagName === 'OL') {
                        li.parentNode.parentNode.insertBefore(ul, li.parentNode);
                    }

                    ul.appendChild(li.cloneNode(true));

                    li.parentNode.removeChild(li);
                });

                temp.querySelectorAll('li[data-list]').forEach(li => {
                    li.removeAttribute('data-list');
                });

                return temp.innerHTML;
            }

            return this.sections.map((s, idx) => ({
                categoryName: s.categoryName || 'Section ' + (idx + 1),
                descriptionHtml: normalizeQuillLists(s.descriptionHtml || ''),
                qty: s.qty || 1,
                unitPrice: s.unitPrice || 0,
                cost: s.cost || 0
            }));
        },

                saveDraft() {
                    document.getElementById('sectionsJson').value = JSON.stringify(this.buildSections());
                    document.getElementById('isDraftInput').value = 'true';
                    document.getElementById('quoteForm').submit();
                },

                submitQuote() {
                    if (!this.clientId) { alert('Please select a client.'); return; }
                    document.getElementById('sectionsJson').value = JSON.stringify(this.buildSections());
                    document.getElementById('isDraftInput').value = 'false';
                    document.getElementById('quoteForm').submit();
                }
            };
        }
    </script>
}
